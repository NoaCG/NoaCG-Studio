{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "stranger-rundown-card",
  "version": "1.0.0",
  "name": "Rundown card (third party)",
  "description": "A hand-written OGraf Graphic for e2e/configured/ograf-rundown.spec.ts (E3.2a): three steps, a declared action, every value it was given written onto its root as it came, and a Take it refuses while its data says fail.",
  "author": { "name": "A third party" },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "schema": {
    "type": "object",
    "properties": {
      "headline": { "type": "string", "title": "Headline", "default": "" },
      "score": { "type": "integer", "title": "Score", "default": 0 },
      "fail": { "type": "string", "title": "Fail the Take", "default": "" }
    }
  },
  "stepCount": 3,
  "customActions": [
    { "id": "mark", "name": "Mark", "description": "Writes its argument.", "schema": { "type": "object", "properties": { "v": { "type": "string" } } } }
  ]
}
