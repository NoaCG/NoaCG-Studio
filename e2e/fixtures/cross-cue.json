{
  "version": 2,
  "root": ".fixture",
  "speed": 1,
  "steps": [
    {
      "name": "In",
      "duration": 1.2,
      "ease": "none",
      "spans": { "#badge": [], "#tag": [] },
      "layers": {
        "#box": {
          "x": [{ "time": 0, "value": -900 }, { "time": 0.6, "value": 0, "ease": "power2.out" }],
          "opacity": [{ "time": 0, "value": 0 }, { "time": 0.4, "value": 1 }]
        },
        "#title": {
          "x": [{ "time": 0, "value": -600 }, { "time": 0.8, "value": 0, "ease": "back.out(1.6)" }]
        }
      }
    },
    {
      "name": "Step 2",
      "duration": 1,
      "ease": "none",
      "spans": { "#badge": [{ "start": 0, "end": 1 }], "#tag": [{ "start": 0.2, "end": 0.6 }] },
      "layers": {
        "#badge": {
          "y": [{ "time": 0, "value": 40 }, { "time": 0.5, "value": 0, "ease": "power2.out" }],
          "opacity": [{ "time": 0, "value": 0 }, { "time": 0.5, "value": 1 }]
        },
        "#box": {
          "rotation": [{ "time": 0, "value": 0 }, { "time": 0.6, "value": 90, "ease": "power1.inOut" }]
        },
        "#tag": {
          "x": [{ "time": 0.2, "value": -50 }, { "time": 0.6, "value": 0, "ease": "power2.out" }]
        }
      }
    },
    {
      "name": "Out",
      "duration": 0.9,
      "ease": "none",
      "layers": {
        "#box": {
          "x": [{ "time": 0.2, "value": 0 }, { "time": 0.8, "value": -900, "ease": "power2.in" }],
          "opacity": [{ "time": 0.2, "value": 1 }, { "time": 0.8, "value": 0 }]
        },
        "#title": {
          "x": [{ "time": 0, "value": 0 }, { "time": 0.6, "value": -600, "ease": "power2.in" }]
        },
        "#badge": {
          "opacity": [{ "time": 0, "value": 1 }, { "time": 0.5, "value": 0 }]
        }
      }
    }
  ]
}
