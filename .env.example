# Copy this file to .env (which is gitignored) and fill in what you use.
# Provider and model are non-secret browser preferences. Keys below are server-only.
VITE_AI_PROVIDER=vercel
VITE_AI_MODEL=
# Optional ordered fallback routes. This is the explicit authorization boundary: when
# empty, a request never changes provider/model after failure.
# VITE_AI_FALLBACKS=[{"provider":"openai","model":"example-model"}]
VITE_AI_FALLBACKS=

# AI provider keys - server-only. Never use a VITE_ prefix and never commit real values.
# Configure any subset; a route needs either its managed key or a securely stored user key.
# The MANAGED gateway. On a Vercel deployment you normally set NEITHER: the platform injects
# a short-lived VERCEL_OIDC_TOKEN and the gateway accepts it, which is the preferred
# production credential because nothing has to be rotated by hand. Set AI_GATEWAY_API_KEY for
# a self-host, for CI, or for local dev without `vercel env pull`; an explicit key wins over
# an ambient token.
AI_GATEWAY_API_KEY=
# The DIRECT provider APIs - the four a user brings their own key for, not the funded
# transport. A managed key here also serves the model listing those pickers read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google AI (Gemini). GOOGLE_API_KEY is preferred; GEMINI_API_KEY is accepted for
# compatibility with Google's own tooling.
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Hugging Face Inference Providers. Hugging Face issues USER ACCESS TOKENS, not API keys, and
# the token needs the "Inference Providers" permission or every call answers 401. HF_TOKEN is
# the name their own tooling reads and the one to set; HUGGINGFACE_TOKEN and the older
# HUGGINGFACE_API_KEY are still accepted so an existing deployment keeps working.
HF_TOKEN=

# Required to accept optional user-provided keys. Use a unique random value of at least
# 32 characters. Keys are sealed in an authenticated HttpOnly cookie and never enter
# browser-readable storage, client bundles, logs, or error messages.
AI_KEY_ENCRYPTION_SECRET=

# Provider-call bounds. Defaults are 120000 ms and one retry.
AI_TIMEOUT_MS=120000
AI_RETRY_LIMIT=1

# Per-IP burst gate on /api/ai/generate (BYO-key traffic included). Defaults are a
# 60-second window and 60 requests per window; 0 disables the gate.
AI_GENERATE_RATE_WINDOW_SEC=60
AI_GENERATE_RATE_MAX=60

# Per-IP burst gate on /api/admin/*, in front of the JWT verification round trip. The admin
# surface itself needs no configuration: it exists when a Supabase service key is present and
# at least one row exists in admin_users (create the first with scripts/admin.mjs). See
# docs/ADMIN.md.
ADMIN_RATE_WINDOW_SEC=60
ADMIN_RATE_MAX=120

# Optional JSON keyed by "provider:model". Values are USD per million tokens and produce
# estimate metadata only. Omit an entry rather than publishing a stale estimate.
# Example with illustrative zero values, not real pricing:
# AI_MODEL_PRICING_JSON={"openai:example-model":{"inputPerMillion":0,"outputPerMillion":0}}
AI_MODEL_PRICING_JSON=

# Vercel AI Gateway's per-request fee: USD per Custom Reporting write, one write per unique tag
# on a managed request (every managed call sends one `surface:*` tag). Default 0.000075, the
# documented $0.075 per 1,000 writes and the measured debit (#2015). It is added once to each
# served request's cost, worst case, settlement and fleet spend. Set 0 if Custom Reporting is
# turned off or the reported cost starts including it.
# AI_GATEWAY_TAG_WRITE_USD=0.000075

# Zero-data-retention routing for the TAGGED managed surfaces (NoaCG Pro today), the surface
# equivalent of AI_LITE_REQUIRE_ZDR. Default on. ZDR is a Vercel Pro/Enterprise gateway
# feature, so on a Hobby team this leaves every managed Pro generation failing closed with
# `zdr_unavailable` - correct, and a decision worth making deliberately. Set to 0 only as an
# explicit audit decision to run Pro without ZDR; the /admin Models page reads the same
# catalog, so nothing will claim ZDR that is not being asked for. The no-training floor is
# unaffected either way - it is free on every plan and pinned on in code.
AI_SURFACE_REQUIRE_ZDR=1

# NoaCG Lite - managed, server-owned Creative AI profile. Disabled unless explicitly enabled.
# Exact model routes and provider names never enter the product UI. Managed gateway routes
# fail closed unless an audited provider allowlist is configured. Every managed route
# (primary, fallback, judge) must also be an entry in the server approved-route catalog
# (api/_lib/aiModelCatalog.ts, docs/AI_TASK_REGISTRY.md) - AI_LITE_PRICING_JSON can adjust
# a price but cannot approve a new route.
AI_LITE_ENABLED=0
AI_LITE_PRIMARY_PROVIDER=vercel
AI_LITE_PRIMARY_MODEL=google/gemini-2.5-flash-lite
# THE SECOND ATTEMPT IS THE PRIMARY AGAIN, on purpose - the reasoning and the measurement are
# in api/_lib/aiLiteProfile.ts. Lite's session ceiling is two attempts, and a weaker second
# route turns a recoverable schema miss into a user-visible failure about half the time.
# Pointing this somewhere else is a route decision that needs its own paid measurement, and
# the candidate must be served by a provider in AI_LITE_GATEWAY_PROVIDERS.
AI_LITE_FALLBACK_PROVIDER=vercel
AI_LITE_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# Comma-separated Vercel AI Gateway PROVIDER SLUGS (google, vertex, bedrock, anthropic, …)
# reviewed for who runs the weights and at what precision. Retention is no longer this list's
# job - AI_LITE_REQUIRE_ZDR covers it, gateway-side. Do not enable Lite with an empty list.
AI_LITE_GATEWAY_PROVIDERS=
# ZDR remains the safe default. NOTE THE PLAN GATE: zero-data-retention routing is a Vercel
# Pro/Enterprise feature, so on a Hobby team the gateway answers 403 and every Lite call fails
# closed with `zdr_unavailable` - which is the correct outcome, not a bug. Set to 0 only as an
# explicit, audited decision to run without it: the first-use disclosure notice
# (src/ai/consentNotice.ts, migration 0014) is deployed, but a non-ZDR route still needs its
# own retention audit. Turning it off does NOT turn off the no-training floor -
# `disallowPromptTraining` is free on every plan, pinned on in code, and not configurable.
# This setting is server-only.
AI_LITE_REQUIRE_ZDR=1
# Use "tool" only for an audited model that supports forced tools but not JSON Schema output.
AI_LITE_GATEWAY_STRUCTURED_MODE=json-schema
# Set to "off" ONLY for a hybrid-inference route (Ling/Qwen family) whose thinking mode would
# otherwise spend the output budget reasoning - it sends the model's Instant-mode template
# switch (chat_template_kwargs.enable_thinking=false). Unset sends nothing, keeping the
# incumbent's request body byte-identical. Measured on inclusionai/ling-3.0-tiny-free
# 2026-08-12 (docs/MODEL_ROUTE_AUDITS.md).
#AI_LITE_GATEWAY_THINKING=off
# LEAVE THIS UNSET. The version lives in api/_lib/aiLiteProfile.ts beside the prompt it names,
# and unset means "whatever that code is" - which is the only way the ledger's prompt_version
# can be trusted. A concrete value here is a PIN, and a pin goes stale on the next bump while
# the code moves on, so a deployment configured by copying this file would ledger new prompt
# text under an old label. That is the partial-bump failure the profile warns about, and it
# needs nobody to make a mistake - copying this file is the documented setup path.
# Set it ONLY to hold a benchmark to an older prompt on purpose, and unset it again after.
# AI_LITE_PROMPT_VERSION=
# Current server-reviewed USD prices per million tokens, keyed by "provider:model".
# A route without a price entry fails closed instead of making an unbounded request.
# AI_LITE_PRICING_JSON={"vercel:vendor/model":{"inputPerMillion":0.1,"outputPerMillion":0.4}}
AI_LITE_PRICING_JSON=
AI_LITE_MAX_COST_USD=0.007
AI_LITE_DAILY_SUCCESSES=3
AI_LITE_MONTHLY_SUCCESSES=20
AI_LITE_DAILY_STARTS=6
AI_LITE_MONTHLY_STARTS=30
AI_LITE_USER_CONCURRENCY=1
AI_LITE_FLEET_CONCURRENCY=20
AI_LITE_FLEET_DAILY_SPEND_USD=25
AI_LITE_PROMPT_CHARACTERS=2000
AI_LITE_CONVERSATION_TURNS=6
AI_LITE_CONVERSATION_CHARACTERS=6000
AI_LITE_FIELDS=2
AI_LITE_LOGO_BYTES=2000000
AI_LITE_MAX_INPUT_TOKENS=12000
AI_LITE_OUTPUT_TOKENS=1500
AI_LITE_REPAIR_OUTPUT_TOKENS=1000
AI_LITE_TIMEOUT_MS=30000
AI_LITE_EXPIRY_MINUTES=15
# The SKIN experiment: the one Lite call may also return bounded restyling CSS for the
# neutral Skin Canvas chassis. Off = byte-identical prompt/schema; a skin a model emits
# anyway is stripped server-side. Skin-enabled routes need the larger output budget
# (AI_LITE_OUTPUT_TOKENS defaults to 3500 when this is on).
AI_LITE_SKIN_ENABLED=0
# The skin VISION JUDGE: one server-owned, cost-capped vision call scoring the rendered
# hold frame (legibility/hierarchy/brief-fit/strap-shape); below the threshold the caller
# reverts to the house chassis. Fails closed like the generation routes: the judge model
# needs a price entry and, on the managed gateway, the same audited provider allowlist.
AI_LITE_JUDGE_ENABLED=0
AI_LITE_JUDGE_PROVIDER=vercel
AI_LITE_JUDGE_MODEL=google/gemini-2.5-flash
AI_LITE_JUDGE_MAX_COST_USD=0.004
AI_LITE_JUDGE_OUTPUT_TOKENS=400
AI_LITE_JUDGE_INPUT_TOKENS=4000
# How many judgements ONE generation may book (attempts, not successes - one judgement
# plus room for two transient provider retries). Without a cap, a single generation id
# the caller owns is an unbounded handle on the judge's spend.
AI_LITE_JUDGE_MAX_PER_GENERATION=3
# Minimum every judge axis must reach for a pass (1-5). Calibrate against blind review
# (docs/AI_LITE_BENCHMARK.md) before trusting it anywhere near production.
AI_LITE_JUDGE_THRESHOLD=3
# Aggregate accepted/discarded chassis outcomes become a subtle routing prior only
# after this content-free sample threshold, looking back over this many days.
AI_LITE_PRIOR_MIN_SAMPLES=8
AI_LITE_PRIOR_WINDOW_DAYS=90
# Comma-separated authenticated Supabase user UUIDs (the id column, never an email address)
# with expanded development/evaluation allowances. This is server-only and cannot be enabled by
# query parameters or localStorage.
#
# It is NOT only an access flag. `liteProfileForUser` raises a listed user's daily AND monthly
# successes and starts to 10,000 each and their concurrency to at least 2 - so every per-user
# quota above stops applying to these accounts and the only spend control left for them is
# AI_LITE_FLEET_DAILY_SPEND_USD, which they share with every other Lite user. List only accounts
# you are willing to hand that budget to.
AI_LITE_OVERRIDE_USER_IDS=
# Local benchmark only. Uses an in-process ledger when not running in production or Vercel.
# Never configure this on a deployed instance.
AI_LITE_EVAL_MEMORY_LEDGER=0
# The account the AI eval tooling runs as (scripts/lite-eval-token.mjs, bench-env.mjs). This
# repository is public, so no address is committed: unset, the tooling falls back to this
# machine's `git config user.email`, and any entry point also takes the address as an argument.
NOACG_EVAL_EMAIL=

# ── HOSTED NoaCG Pro ────────────────────────────────────────────────────────────────────
#
# Pro on NoaCG's own key, against NoaCG's own allowance: the user chooses no provider, no
# model and no key. OFF BY DEFAULT, and that default is a price decision rather than a
# configuration one. It was taken when a Pro generation cost a MEASURED $0.0777, 86% of it one
# flat image charge; Phase A retired that engine and the measurement is now $0.0039 - about 12x
# a Lite one (docs/NOACG_PRO_PLAN.md §16). Still an owner decision, on a much smaller number.
# With this off, the Pro tier behaves exactly as it did before hosted Pro existed: a user's own
# AI Gateway key, or the offline deterministic stub.
#
# Turning it on needs migration 0044 applied FIRST - the ledger cannot admit a 'pro' row
# without it, and every generation would fail on its reservation.
AI_PRO_ENABLED=0
# The ONE curated route hosted Pro spends on: Phase A's design-language call. It must be an
# entry in the approved-route catalog (api/_lib/aiModelCatalog.ts); unset uses
# PRO_STANDARD_ROUTES.language, which is the audited one.
#
# Everything on this list is ANDed by the availability gate - a funded route that is unpriced,
# unapproved or switched off from /admin takes the whole tier down. That is why the retired
# engine's image route is no longer here: disabling a model nothing calls must not cost the
# tier (docs/NOACG_PRO_PLAN.md §16). Do not add a route Pro does not spend on.
AI_PRO_LANGUAGE_PROVIDER=vercel
AI_PRO_LANGUAGE_MODEL=google/gemini-2.5-flash
# Audited gateway provider slugs, same meaning as AI_LITE_GATEWAY_PROVIDERS - which is also
# the fallback when this is unset. Do not enable Pro with both empty: the task fails closed.
AI_PRO_GATEWAY_PROVIDERS=
AI_PRO_REQUIRE_ZDR=1
# What ONE generation may cost, every model call together. Enforced server-side against the
# reservation AND in the browser pipeline, deliberately against the same number.
AI_PRO_MAX_COST_USD=0.15
# How many model calls one reservation pays for. Phase A's pipeline makes one; the rest is
# headroom for transient provider retries. Without a cap a generation id is an unbounded
# spend handle - the same lesson AI_LITE_JUDGE_MAX_PER_GENERATION records.
AI_PRO_MAX_CALLS=4
# The allowance, set against the retired engine's $0.0777 a generation, where three starts a
# day was about €0.21 of NoaCG's money per user per day. At Phase A's $0.0039 the same three
# cost about a cent. Left where they are on purpose: what a free tier hands out is an owner
# decision, not a consequence of the engine getting cheaper. The fleet ceiling is the backstop
# when a lot of users appear at once.
AI_PRO_DAILY_STARTS=3
AI_PRO_MONTHLY_STARTS=10
AI_PRO_DAILY_SUCCESSES=2
AI_PRO_MONTHLY_SUCCESSES=8
AI_PRO_USER_CONCURRENCY=1
AI_PRO_FLEET_CONCURRENCY=4
AI_PRO_FLEET_DAILY_SPEND_USD=5
AI_PRO_TIMEOUT_MS=120000
AI_PRO_EXPIRY_MINUTES=15
# The CUSTOM lane (the fail-closed iterate engine) - OFF by default, and separate from
# AI_PRO_ENABLED on purpose: it is productized for VALIDATION, and whether it ships is decided
# by the P4 confirmation round's owner read, never by hosting Pro at all.
AI_PRO_CUSTOM_ENABLED=0
# How long to wait before re-asking for a fleet slot when every one is taken. A class presses
# Create within seconds of each other, so the reservation RETRIES the shared slot (jittered,
# at most three observations) instead of handing most of the room an error.
#
# Follows the first MEASURED turnover: 62 s for a real slot cycle (docs/NOACG_PRO_PLAN.md), and
# Lite's rule - space at about half the turnover so three attempts straddle one full cycle -
# puts it near 31 s. Clamped 0.5-60 s; `POST /api/ai/pro-outcome` keeps recording `runtime_ms`
# so the number can keep following the fleet's real behaviour.
AI_PRO_RETRY_SPACING_MS=31000
# Same shape and same warning as AI_LITE_OVERRIDE_USER_IDS: a listed account's per-user
# quotas stop applying and the only spend control left for them is the shared fleet ceiling.
AI_PRO_OVERRIDE_USER_IDS=

# Local diagnosis only. Logs each gateway answer's finish_reason and usage block, plus the head
# and tail of any structured answer that failed to parse. Off by default because it prints model
# output to the server log; turn it on when a task is failing with "invalid structured result"
# and you need to know whether the answer was wrong or merely truncated - a maxTokens sized
# before reasoning tokens existed truncates silently and reads as a model failure
# (benchmarks/pro/round-2026-08-08/ROUND.md §3).
NOACG_DEBUG_STRUCTURED=0

# Import Graphic AI analysis (docs/AI_TASK_REGISTRY.md) - the proposal-only vision task
# on the Import Graphic flow. Disabled unless explicitly enabled; requires migration 0015
# and, like Lite, an audited gateway provider allowlist (its own, or Lite's as the
# fallback). The route must be a vision-capable approved-route catalog entry.
AI_TASK_IMPORT_ANALYSIS_ENABLED=0
AI_IMPORT_ANALYSIS_PROVIDER=vercel
AI_IMPORT_ANALYSIS_MODEL=google/gemini-2.5-flash
AI_IMPORT_ANALYSIS_GATEWAY_PROVIDERS=
AI_IMPORT_ANALYSIS_REQUIRE_ZDR=1
AI_IMPORT_ANALYSIS_MAX_COST_USD=0.01
# Ratified quota (plan §15 decision 3): successes are the entitlement; starts are the
# looser abuse caps.
AI_IMPORT_ANALYSIS_DAILY_SUCCESSES=10
AI_IMPORT_ANALYSIS_MONTHLY_SUCCESSES=100
AI_IMPORT_ANALYSIS_DAILY_STARTS=20
AI_IMPORT_ANALYSIS_MONTHLY_STARTS=200
AI_IMPORT_ANALYSIS_FLEET_DAILY_SPEND_USD=10

# ── Supabase backend (Era 5) — all OPTIONAL. Leave blank to run in pure offline mode ──
# (no login, no cloud sync, exports unchanged — exactly the self-hostable offline tool).
# The anon key is PUBLIC (Row Level Security is the real boundary) so it is safe to ship in the
# client bundle. NEVER put the service_role key here or in any VITE_-prefixed var — those are
# bundled into the browser. Server secrets belong in the private deployment's secret store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Note: there is no "require auth" switch. With a backend configured, the editor is still open to
# everyone — signing in only unlocks the account features (cloud sync, community, AI).

# The Supabase MANAGEMENT API personal access token (Dashboard → Account → Access Tokens). This is
# what `npm run db:push` uses to apply pending migrations, and what `npm run check:advisors` and
# `npm run check:migration-drift` read the project with. Without it those three report "not checked"
# and stand down; nothing else in the repo needs it.
#
# TREAT IT AS THE MOST DANGEROUS VALUE IN THIS FILE. It is ACCOUNT-WIDE, not per project: it
# enumerates every organisation and project on the account, and the same API deletes them. That is
# why it is never shipped to CI — this repo is public, and no GitHub secret should be able to do
# more than the suite it serves. It lives here, on a maintainer's machine, and is used at the moment
# a human is at the keyboard.
#
# The push needs NO database password: the CLI initialises a temporary login role over this token.
# `SUPABASE_PROJECT_REF` overrides the target project, which is how a run is pointed at staging
# instead of the project VITE_SUPABASE_URL names; leave it unset for normal work.
SUPABASE_ACCESS_TOKEN=
#SUPABASE_PROJECT_REF=

# ── Configured-mode E2E (npm run test:e2e:live) — OPTIONAL, maintainer-only ──────────────────────
# A THROWAWAY test account (email/password, allowlisted) used to exercise the authenticated
# community flows. Leave blank and the live suite skips. These are NOT VITE_-prefixed, so they are
# never bundled into the client.
#
# THE SUITE NO LONGER USES THE BACKEND ABOVE, and cannot be pointed at one. It publishes and
# deletes rows, and several specs hold the service_role key, so since issue #2495 it refuses to
# start unless VITE_SUPABASE_URL names a LOCAL stack of its own: `supabase start`, then take the
# settings from `supabase status` (scripts/configured-trial.mjs does exactly that). A production or
# staging URL here is refused rather than used.
E2E_EMAIL=
E2E_PASSWORD=
# Optional: the service_role key (server secret — NEVER a VITE_ var) enables the moderator spec, which
# needs to grant/revoke the test account's moderator role. Without it that spec skips.
SUPABASE_SERVICE_ROLE_KEY=

# ── Video/image rendering (Era 7) — all OPTIONAL; leave blank and the feature does not exist ────
# Client flag: shows the Export tab's "Video & image" section. Set on hosted deployments
# (and locally for the offline dev loop — rendering then runs on THIS machine).
VITE_RENDER_API=

# Server-only (Vercel project env / local .env for the dev-server api middleware — NEVER VITE_):
# 'sandbox' on Vercel (renders in Vercel Sandbox); unset/anything else = local child process.
RENDER_EXECUTOR=
# From the Vercel Blob store (Storage → Blob → connect). Holds finished renders until TTL.
BLOB_READ_WRITE_TOKEN=
# Bearer expected by the /api/render/cleanup cron (Vercel sends it automatically when set).
CRON_SECRET=
# Salts anonymous per-IP render quotas. Any long random string.
IP_HASH_SALT=
# The render_jobs ledger reuses VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY plus a Supabase
# secret key. Prefer the new sb_secret_… secret key here; the legacy service_role JWT in
# SUPABASE_SERVICE_ROLE_KEY (above) is still accepted as a fallback. Without either, render
# jobs live in process memory (fine for the local dev loop).
SUPABASE_SECRET_KEY=

# ── External data connectors — OPTIONAL, and never read by the app ───────────────────────────────
# A connector is a separate process that reads a provider and pushes through the Production Data
# API (docs/CLOUD_PLAYOUT.md §7). Nothing here is bundled, so none of it may take a VITE_ prefix.
#
# TheSportsDB (docs/SPORTSDB.md, scripts/sportsdb-feed.mjs). Unset falls back to their PUBLIC
# test key `123` — free, 30 requests/minute, one result per query, which is enough for
# development and demos. Set this only for a paid key, which is a real secret.
THESPORTSDB_API_KEY=
