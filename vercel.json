{
  "cleanUrls": true,
  "buildCommand": "npm run build:vercel && npm --prefix render-worker ci && node render-worker/bundle.mjs",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "functions": {
    "api/ai/generate.ts": { "maxDuration": 300 },
    "api/render/start.ts": {
      "maxDuration": 300,
      "includeFiles": "render-worker/{bundle/**,sandbox-job.mjs}"
    },
    "api/render/cleanup.ts": { "maxDuration": 300 },
    "api/status.ts": { "maxDuration": 10 },
    "api/data/[...path].ts": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/render/cleanup", "schedule": "30 3 * * *" },
    { "path": "/api/data/tick", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/join/:name", "destination": "/join" },
    { "source": "/ograf/:sealed/:path*", "destination": "/api/output/assets?ograf=:sealed&path=:path*" },
    { "source": "/mcp", "destination": "/api/me/mcp" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/me/oauth-protected-resource" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/output",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/join/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/bridge",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/((?!output$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
