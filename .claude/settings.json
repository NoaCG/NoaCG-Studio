  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/hooks/session-start.mjs" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-command.mjs" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-edit.mjs" }]
      },
      {
        "matcher": "mcp__ccd_session__spawn_task",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/spawn-task-guard.mjs" }]
      },
      {
        "matcher": "mcp__Claude_Browser__preview_start",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-preview.mjs" }]
      },
      {
        "matcher": "Agent",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-agent-launch.mjs" }]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/guard-question.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/warn-command.mjs" }]
      },
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/warn-edit.mjs" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node scripts/hooks/lint-file.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/hooks/stop-wait.mjs" }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/hooks/stop-wait.mjs" }]
      }
    ]
  }
}
