  "html": "<!doctype html><html><head><meta charset=\"UTF-8\"><script id=\"spx-template-definition\">window.SPXGCTemplateDefinition={\"description\":\"Synthetic Finnish election rehearsal\",\"playserver\":\"OVERLAY\",\"playchannel\":\"1\",\"playlayer\":\"1\",\"webplayout\":\"1\",\"out\":\"manual\",\"steps\":\"0\",\"dataformat\":\"json\",\"uicolor\":\"7\",\"DataFields\":[{\"field\":\"f0\",\"title\":\"Candidate\",\"value\":\"Aino Example\",\"ftype\":\"textfield\"},{\"field\":\"f1\",\"title\":\"Party and district\",\"value\":\"KOK · Uusimaa\",\"ftype\":\"textfield\"},{\"field\":\"f2\",\"title\":\"Votes\",\"value\":\"\",\"ftype\":\"textfield\"},{\"field\":\"f3\",\"title\":\"Status\",\"value\":\"\",\"ftype\":\"textfield\"},{\"field\":\"f4\",\"title\":\"Portrait\",\"value\":\"data:image/svg+xml;base64,\",\"ftype\":\"filelist\"}]};</script></head><body><main id=\"graphic\"><header><span>FINLAND / PARLIAMENT 2027</span><b>REHEARSAL · SYNTHETIC DATA</b></header><div class=\"hero\"><img class=\"portrait\" id=\"f4\" alt=\"\"/><div><div class=\"name\" id=\"f0\">Aino Example</div><div class=\"sub\" id=\"f1\">KOK · Uusimaa</div><div class=\"status\" id=\"f3\"></div></div><div class=\"votes\" id=\"f2\"></div></div><footer>Sample artwork · Fictional candidates · Illustrative seat projections</footer></main></body></html>",
  "css": "*{box-sizing:border-box}body{margin:0;background:#07131c;color:#edf5f5;font:26px Arial,sans-serif}#graphic{visibility:hidden;padding:54px 70px}header{display:flex;justify-content:space-between;font-size:20px;letter-spacing:2px;border-bottom:2px solid #42606e;padding-bottom:24px;margin-bottom:30px}header b{color:#efc16d;font-size:17px}h1{font-size:52px;margin:18px 0 28px}table{width:100%;border-collapse:collapse}th{font-size:16px;color:#9bb8c3;text-align:right;padding:7px 12px}td{padding:9px 12px;border-bottom:1px solid #203744;text-align:right;font-variant-numeric:tabular-nums;font-size:27px}td:first-child,th:first-child{text-align:left}td:first-child{display:flex;gap:16px;align-items:center}td img{width:35px;height:35px}footer{position:absolute;bottom:32px;left:70px;color:#91a8b7;font-size:17px}.hero{display:flex;align-items:center;gap:46px;background:#102b3c;border-left:7px solid #68d9c5;padding:44px;margin-top:120px}.portrait{width:190px;height:190px}.name{font-size:55px;font-weight:700}.sub{font-size:26px;color:#a6c7d8;margin-top:18px}.votes{margin-left:auto;font-size:80px;font-weight:bold}.status{color:#80d6c1;font-size:22px;margin-top:18px}.bug{margin:170px auto 0;width:850px;padding:45px;background:#17394a;border-top:7px solid #6dd8c7}.bug strong{font-size:78px}.bug p{color:#bdd1dc}.ticker{margin-top:230px;padding:40px;background:#62d5c5;color:#102333;font-size:38px;white-space:pre-line}",
  "js": "// Write one field value into its element. Text fields get plain\n// text (operator input never runs as HTML); an <img id=\"fN\"> gets the value as its image path.\nfunction setFieldValue(el, value) {\n  if (el.tagName === 'IMG') {\n    if (value) { el.src = value; el.style.display = ''; }\n    else { el.removeAttribute('src'); el.style.display = 'none'; }  // empty = show the design's placeholder\n    // The img's parent gets .has-image so the CSS can hide a placeholder mark, resize, etc.\n    if (el.parentNode && el.parentNode.classList) el.parentNode.classList.toggle('has-image', !!value);\n  } else if (el.tagName === 'image') {\n    // An SVG picture slot (an imported design's own <image> layer): swap its href. Empty\n    // restores the picture the designer drew, so an untouched field changes nothing.\n    if (!el.hasAttribute('data-orig-href')) el.setAttribute('data-orig-href', el.getAttribute('href') || '');\n    el.setAttribute('href', value || el.getAttribute('data-orig-href'));\n  } else {\n    el.textContent = value;\n  }\n}\nvar researchActions={play:0,stop:0,next:0};\nfunction play(){researchActions.play++;document.getElementById('graphic').style.visibility='visible';}\nfunction stop(){researchActions.stop++;document.getElementById('graphic').style.visibility='hidden';}\nfunction next(){researchActions.next++;}\nfunction update(data){var values=typeof data==='string'?JSON.parse(data):data;Object.keys(values).forEach(function(k){var el=document.getElementById(k);if(el)setFieldValue(el,String(values[k]));});}\n"
}
