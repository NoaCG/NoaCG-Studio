+  "fps": 25,
+  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Clean Steps</title>\n\n  <!-- GSAP animation library (bundled locally — no internet needed at playout). -->\n  <script src=\"js/gsap.min.js\"></script>\n\n  <!-- Template styles and logic. -->\n  <link rel=\"stylesheet\" href=\"css/template.css\" />\n  <script src=\"js/template.js\"></script>\n\n  <!-- SPX template definition: the data fields shown to the operator. -->\n  <script id=\"spx-template-definition\" type=\"text/javascript\">\nwindow.SPXGCTemplateDefinition = {\n    \"description\": \"Clean Steps\",\n    \"playserver\": \"OVERLAY\",\n    \"playchannel\": \"1\",\n    \"playlayer\": \"7\",\n    \"webplayout\": \"7\",\n    \"out\": \"manual\",\n    \"steps\": \"5\",\n    \"dataformat\": \"json\",\n    \"uicolor\": \"1\",\n    \"DataFields\": [\n        {\n            \"field\": \"f0\",\n            \"ftype\": \"textfield\",\n            \"title\": \"Heading\",\n            \"value\": \"Harbour bulletin\"\n        },\n        {\n            \"field\": \"f1\",\n            \"ftype\": \"textfield\",\n            \"title\": \"Step 1\",\n            \"value\": \"Post your question in the chat\"\n        },\n        {\n            \"field\": \"f2\",\n            \"ftype\": \"textfield\",\n            \"title\": \"Step 2\",\n            \"value\": \"Add your first name and where you are watching from\"\n        },\n        {\n            \"field\": \"f3\",\n            \"ftype\": \"textfield\",\n            \"title\": \"Step 3\",\n            \"value\": \"Our producer picks questions from 20:30\"\n        },\n        {\n            \"field\": \"f4\",\n            \"ftype\": \"textfield\",\n            \"title\": \"Step 4\",\n            \"value\": \"Stay on the line — we may bring you on air\"\n        },\n        {\n            \"field\": \"f5\",\n            \"ftype\": \"filelist\",\n            \"title\": \"Logo\",\n            \"value\": \"images/harbour.svg\",\n            \"assetfolder\": \"./images/\",\n            \"extension\": \"png\"\n        }\n    ]\n};\n</script>\n</head>\n<body>\n  <!-- Info card. Hidden until play(); positioned by the .info-card rule in the CSS. -->\n  <div class=\"info-card\">\n    <!-- Process card: a heading, then the ordered steps. Each SPX Continue reveals one. -->\n    <div class=\"info-card-box\">\n      <!-- Logo (image field f5) — a band above the text. Empty = hidden. -->\n      <img src=\"images/harbour.svg\" id=\"f5\" class=\"info-card-logo\" alt=\"\" />\n      <!-- The accent motif — the design's one loud color moment. -->\n      <div class=\"info-card-accent\"></div>\n      <!-- Heading (f0) — SPX writes this field's value straight into the element. -->\n      <div class=\"info-card-mask\"><span id=\"f0\" class=\"info-card-heading\">Harbour bulletin</span></div>\n      <!-- Step 1 (f1) — SPX writes this field's value straight into the element. -->\n      <div class=\"info-card-mask\"><span id=\"f1\" class=\"info-card-step info-card-step-first\">Post your question in the chat</span></div>\n      <!-- Step 2 (f2) — SPX writes this field's value straight into the element. -->\n      <div class=\"info-card-mask\"><span id=\"f2\" class=\"info-card-step\">Add your first name and where you are watching from</span></div>\n      <!-- Step 3 (f3) — SPX writes this field's value straight into the element. -->\n      <div class=\"info-card-mask\"><span id=\"f3\" class=\"info-card-step\">Our producer picks questions from 20:30</span></div>\n      <!-- Step 4 (f4) — SPX writes this field's value straight into the element. -->\n      <div class=\"info-card-mask\"><span id=\"f4\" class=\"info-card-step\">Stay on the line — we may bring you on air</span></div>\n    </div>\n  </div>\n</body>\n</html>\n",
+  "css": "/* Supporting face (bundled OFL file — ships with the export, offline at playout).\n   A style variable points at this face, so its file ships with the graphic. */\n@font-face {\n  font-family: \"Saira\";\n  src: url(\"fonts/saira.woff2\") format(\"woff2\");\n  font-weight: 400 900;  /* variable font: covers this weight range */\n  font-display: swap;          /* show fallback text until the font loads */\n}\n@font-face {\n  font-family: \"Saira\";\n  src: url(\"fonts/saira-latin-ext.woff2\") format(\"woff2\");\n  font-weight: 400 900;  /* variable font: covers this weight range */\n  font-display: swap;\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;  /* latin-ext: Š Ž Ł ő ğ and the rest of Latin Extended */\n}\n\n/* Clean Steps — generated by NoaCG Studio. Edit freely: this file is yours. */\n\n/* ── Style contract: change these variables to retint the whole graphic. ── */\n:root {\n  --accent: #16bb99;           /* the one accent color */\n  --text-color: #ffffff;          /* primary text */\n  --text-dim: #b8c4d6;  /* secondary text (title line) */\n  --panel-bg: #112233;  /* the panel behind the text */\n  --font-heading: \"Oswald\", \"Arial Narrow\", Arial, sans-serif;  /* the graphic's typeface */\n  --scale: 1;                  /* whole-graphic size multiplier (also handles resolution) */\n  --type-scale: 1;                  /* text-only size multiplier (on top of --scale) */\n  --accent-weight: calc(3px * var(--scale));    /* thickness of the accent bar */\n  --font-label: var(--font-heading);            /* the label/kicker typeface */\n  --label-tracking: 0.16em;                     /* label letter-spacing (small caps breathe) */\n  --label-color: var(--text-dim);               /* label colour */\n}\n\n/* Bundled open-source font (the file ships with the export — no internet at playout). */\n@font-face {\n  font-family: \"Oswald\";\n  src: url(\"fonts/oswald.woff2\") format(\"woff2\");\n  font-weight: 400 700;  /* variable font: covers this weight range */\n  font-display: swap;          /* show fallback text until the font loads */\n}\n@font-face {\n  font-family: \"Oswald\";\n  src: url(\"fonts/oswald-latin-ext.woff2\") format(\"woff2\");\n  font-weight: 400 700;  /* variable font: covers this weight range */\n  font-display: swap;\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;  /* latin-ext: Š Ž Ł ő ğ and the rest of Latin Extended */\n}\n\n/* Reset and a transparent canvas (broadcast graphics render over video). */\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body {\n  width: 1920px;\n  height: 1080px;\n  overflow: hidden;                /* nothing ever scrolls on air */\n  background: transparent;\n  font-family: var(--font-heading);\n}\n\n/* ── Root position (anchor zone) ── */\n.info-card {\n  position: absolute;\n  left: 120px;                     /* inset from the left edge (safe area) */\n  top: calc(50% + 0px);            /* anchored to the vertical center */\n  transform: translateY(-50%);     /* center on the anchor point */\n  text-align: left;                /* lines align toward the anchor edge */\n  opacity: 0;                      /* hidden until play() runs the entrance */\n}\n\n/* ── The stage: the panel keeps its own width and the text fits inside it. ── */\n.info-card-box {\n  --stage-width: 1080px;      /* the room this graphic was drawn for — this panel's width is the design's, never the text's */\n  width: 1080px;  /* fallback: no CSS min() before Chromium 79 (older CasparCG) */\n  width: min(calc(1080px * var(--scale)), 1680px);\n  box-sizing: border-box;          /* the declared width includes the panel's own padding */\n  justify-conten