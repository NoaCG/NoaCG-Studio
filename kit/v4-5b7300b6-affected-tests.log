        onAir: (graphic) => !holds.has(graphic) && onAirHere(graphic),
        data: (graphic) => heldData(graphic),
        warmData: (graphic, next) => (touched.has(graphic) ? heldData(graphic) : firstCueOf(next.cues, graphic)),
