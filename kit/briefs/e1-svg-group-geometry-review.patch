+/** A generated SVG group repeats the same base initializer in every cue. The caller proves artwork ownership. */
+export function groupPivotInitializer(data: AnimData, selector: string): AnimKeyframe | undefined {
+  const first = data.steps[0]?.layers[selector]?.transformOrigin?.[0];
+  if (!first || typeof first.value !== 'string') return;
+  if (data.steps.every(step => {
+    const keys = step.layers[selector]?.transformOrigin;
+    return keys?.length === 1 && keys[0].time === 0 && keys[0].ease === undefined && keys[0].value === first.value;
+  })) return first;
+}
+
+/** Data owners with authored anchor motion and the generated group initializer shape. */
+export function keyedGroupPivotInitializers(data: AnimData): Map<string, AnimKeyframe> {
+  const owners = new Set(data.steps.flatMap(step => Object.keys(step.layers).filter(selector => {
+    const tracks = step.layers[selector];
+    return tracks['--base-anchor-x']?.length || tracks['--base-anchor-y']?.length;
+  })));
+  const pivots = new Map<string, AnimKeyframe>();
+  for (const selector of owners) {
+    const key = groupPivotInitializer(data, selector);
+    if (key) pivots.set(selector, key);
+  }
+  return pivots;
+}
